{
  "name": "streammax-windows",
  "version": "0.1.0",
  "private": true,
  "description": "StreamMax Windows desktop prototype",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis",
    "test": "node --test"
  },
  "build": {
    "appId": "com.streammax.desktop",
    "productName": "StreamMax",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "index.html",
      "renderer.js",
      "assets/**/*",
      "home-state.js",
      "catalog-contract.js",
      "auth-flow.js",
      "auth-rpc.js",
      "auth-service.js"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "assets/streammax.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "StreamMax"
    }
  },
  "devDependencies": {
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8"
  }
}
