<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-feature android:name="android.software.leanback" android:required="false"/>
    <uses-feature android:name="android.hardware.touchscreen" android:required="false"/>

    <!-- Package visibility: list only installed activities that identify as launchable apps. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN"/>
            <category android:name="android.intent.category.LEANBACK_LAUNCHER"/>
        </intent>
        <intent>
            <action android:name="android.intent.action.MAIN"/>
            <category android:name="android.intent.category.LAUNCHER"/>
        </intent>
    </queries>

    <!-- No INTERNET permission, no accessibility, no device administrator, no system modification. -->
    <application
        android:allowBackup="false"
        android:usesCleartextTraffic="false"
        android:label="StreamMax Home Teste"
        android:theme="@android:style/Theme.Material.NoActionBar"
        android:banner="@drawable/home_banner"
        android:icon="@android:drawable/ic_menu_view"
        android:supportsRtl="true">
        <activity
            android:name=".HomeActivity"
            android:exported="true"
            android:screenOrientation="landscape"
            android:launchMode="singleTop">
            <!-- Intentionally NOT HOME yet: test safely without replacing Google's launcher. -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LEANBACK_LAUNCHER"/>
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
    </application>
</manifest>
