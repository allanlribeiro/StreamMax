// Mesa surfaceless: shader e blend reais; a referencia usa interpolacao
// generica dos colorStops do Compose, independente da formula do shader.
#include <EGL/egl.h>
#include <GLES2/gl2.h>
#include <assert.h>
#include <math.h>
#include <stdio.h>
#include <string.h>
#include "shader.h"
typedef struct { float x,y,w,h; } GfxRect;
enum { GFX_FURO_HERO };
enum { W=320, H=192 };
static int dinPendente, ambPendente, ambIntacta;
static float escAtiva=1;
static GLuint program;
static const float background[3]={0.025f,0.04f,0.08f};
static void dinDescarregar(void) { assert(0); }
static void gfx_ambiente_descarregar(void) { assert(0); }
static void vidroFuro(GfxRect r) { (void)r; }
#define GFX_TR_RECT(x,y,w,h) ((void)0)
static GLuint shader(GLenum type,const char *src) {
  GLuint s=glCreateShader(type); assert(s);
  glShaderSource(s,1,&src,NULL); glCompileShader(s);
  GLint ok=0; glGetShaderiv(s,GL_COMPILE_STATUS,&ok);
  if(!ok) { char msg[4096]; glGetShaderInfoLog(s,sizeof msg,NULL,msg); fprintf(stderr,"%s\n",msg); }
  assert(ok); return s;
}
static void gfx_rect(GfxRect r,GLuint tex,int modo,float foco,float px,float py,float raio,float cr,float cg,float cb,float ca) {
  (void)tex;(void)modo;(void)py;(void)raio;(void)cr;(void)cg;(void)cb;(void)ca;
  float x=r.x*2/W-1, y=r.y*2/H-1, w=r.w*2/W, h=r.h*2/H;
  float v[]={x,y,0,0, x+w,y,1,0, x,y+h,0,1, x+w,y+h,1,1};
  glUseProgram(program);
  glUniform1f(glGetUniformLocation(program,"uFoco"),foco);
  glUniform2f(glGetUniformLocation(program,"uPar"),px,0);
  glUniform3fv(glGetUniformLocation(program,"uFundo"),1,background);
  GLint pos=glGetAttribLocation(program,"aPos"),uv=glGetAttribLocation(program,"aUv");
  glVertexAttribPointer(pos,2,GL_FLOAT,GL_FALSE,4*sizeof(float),v);
  glVertexAttribPointer(uv,2,GL_FLOAT,GL_FALSE,4*sizeof(float),v+2);
  glEnableVertexAttribArray(pos); glEnableVertexAttribArray(uv);
  glDrawArrays(GL_TRIANGLE_STRIP,0,4);
  assert(glGetError()==GL_NO_ERROR);
}
/* PRODUCTION_COMPOSITOR */
static float interp(float t,const float *stops,const float *values,int n) {
  if(t<=stops[0]) return values[0];
  for(int i=1;i<n;i++) if(t<=stops[i])
    return values[i-1]+(values[i]-values[i-1])*(t-stops[i-1])/(stops[i]-stops[i-1]);
  return values[n-1];
}
static float gradient(float x,float y,int full) {
  const float xs[]={0,.22f,.46f,.76f,1};
  const float xb[]={1,.86f,.56f,.16f,0},xf[]={1,.90f,.80f,.42f,0};
  const float ys[]={0,.40f,.75f,1},yf[]={0,.30f,.60f,1},ya[]={0,.25f,.65f,1},yaf[]={0,.35f,.75f,1};
  float ah=interp(x/(full?.65f:.45f),xs,full?xf:xb,5);
  float start=full?.64f:.82f;
  float av=interp((y-start)/(1-start),full?yf:ys,full?yaf:ya,4);
  return av+ah*(1-av);
}
int main(void) {
  EGLDisplay d=eglGetDisplay(EGL_DEFAULT_DISPLAY); assert(d!=EGL_NO_DISPLAY);
  assert(eglInitialize(d,NULL,NULL)); assert(eglBindAPI(EGL_OPENGL_ES_API));
  const EGLint attrs[]={EGL_SURFACE_TYPE,EGL_PBUFFER_BIT,EGL_RENDERABLE_TYPE,EGL_OPENGL_ES2_BIT,EGL_RED_SIZE,8,EGL_GREEN_SIZE,8,EGL_BLUE_SIZE,8,EGL_ALPHA_SIZE,8,EGL_NONE};
  EGLConfig cfg; EGLint n; assert(eglChooseConfig(d,attrs,&cfg,1,&n)&&n==1);
  const EGLint size[]={EGL_WIDTH,W,EGL_HEIGHT,H,EGL_NONE};
  const EGLint version[]={EGL_CONTEXT_CLIENT_VERSION,2,EGL_NONE};
  EGLSurface surf=eglCreatePbufferSurface(d,cfg,size); assert(surf!=EGL_NO_SURFACE);
  EGLContext ctx=eglCreateContext(d,cfg,EGL_NO_CONTEXT,version); assert(ctx!=EGL_NO_CONTEXT);
  assert(eglMakeCurrent(d,surf,surf,ctx));
  const char *vs="attribute vec2 aPos; attribute vec2 aUv; varying highp vec2 vUv; void main(){vUv=aUv;gl_Position=vec4(aPos,0,1);}";
  char fs[8192]; snprintf(fs,sizeof fs,"precision highp float; varying highp vec2 vUv; uniform float uFoco; uniform vec2 uPar; uniform vec3 uFundo;\n%s",fragment_body);
  GLuint v=shader(GL_VERTEX_SHADER,vs),f=shader(GL_FRAGMENT_SHADER,fs);
  program=glCreateProgram(); glAttachShader(program,v); glAttachShader(program,f); glLinkProgram(program);
  GLint linked; glGetProgramiv(program,GL_LINK_STATUS,&linked); assert(linked);
  glViewport(0,0,W,H); glDisable(GL_DITHER); glEnable(GL_BLEND);
  const float old[3]={.60f,.20f,.10f};
  GfxRect r={16,24,288,144};
  unsigned char pixels[W*H*4];
  unsigned checked=0;
  for(int full=0;full<2;full++) for(int step=0;step<=4;step++) {
    float a=step*.25f;
    glClearColor(old[0],old[1],old[2],1); glClear(GL_COLOR_BUFFER_BIT);
    glBlendFuncSeparate(GL_SRC_ALPHA,GL_ONE_MINUS_SRC_ALPHA,GL_ONE,GL_ONE_MINUS_SRC_ALPHA);
    gfx_furo_hero_suave(r,a,full);
    glReadPixels(0,0,W,H,GL_RGBA,GL_UNSIGNED_BYTE,pixels);
    assert(glGetError()==GL_NO_ERROR);
    for(int y=0;y<H;y+=3) for(int x=0;x<W;x+=3) {
      int inside=x>=16 && x<304 && y>=24 && y<168;
      float g=inside?gradient((x+.5f-r.x)/r.w,(y+.5f-r.y)/r.h,full):0;
      float k=inside?a:0;
      const unsigned char *p=pixels+4*(y*W+x);
      for(int c=0;c<4;c++) {
        float expected=c==3?1-k+k*g:old[c]*(1-k)+background[c]*k*g;
        if(fabsf(p[c]/255.0f-expected)>.009f) {
          fprintf(stderr,"full=%d fade=%g pixel=%d,%d c=%d actual=%g expected=%g\n",full,a,x,y,c,p[c]/255.0f,expected);
          assert(0);
        }
        checked++;
      }
    }
    GLint state;
    glGetIntegerv(GL_BLEND_SRC_RGB,&state); assert(state==GL_SRC_ALPHA);
    glGetIntegerv(GL_BLEND_DST_RGB,&state); assert(state==GL_ONE_MINUS_SRC_ALPHA);
    glGetIntegerv(GL_BLEND_SRC_ALPHA,&state); assert(state==GL_ONE);
    glGetIntegerv(GL_BLEND_DST_ALPHA,&state); assert(state==GL_ONE_MINUS_SRC_ALPHA);
  }
  printf("OK: shader GLES real, %u canais conferidos com paradas do Compose; mistura, limites e blend restaurado\n",checked);
  glDeleteProgram(program);glDeleteShader(v);glDeleteShader(f);
  eglMakeCurrent(d,EGL_NO_SURFACE,EGL_NO_SURFACE,EGL_NO_CONTEXT);
  eglDestroyContext(d,ctx);eglDestroySurface(d,surf);eglTerminate(d);
}
