static Asset frames[3];
GLuint tex_obter_hero_quente(const char *s){requests++;for(int i=0;i<3;i++)if(!strcmp(s,paths[i]))return frames[i].id;return 0;}
float tex_aspecto(const char *s){for(int i=0;i<3;i++)if(s&&!strcmp(s,paths[i]))return (float)frames[i].w/frames[i].h;return 16.f/9;}
