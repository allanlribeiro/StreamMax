static float desenhaCopiaHero(const CatItem *ci,int principal,float x,float base,int lay,int cheio,float logoH,
                             float sinW,int linhas,float a,float copyA,float cin,float btnH,float btnGap,float slot){
 (void)principal;(void)lay;(void)cheio;(void)linhas;(void)a;(void)copyA;(void)cin;
 HeroCopyLayout c=heroCopyLayout(base,60,1,1,0,logoH,btnH,btnGap,base-sm_globo_home(NV_TELA_W,NV_TELA_H).h+104,slot,0);
 int index=ci?ci-items:1;const char *logos[]={"logo-02","logo-10","logo-12"};Asset l=asset(logos[index]);
 float w=fminf(sinW,c.logoHeight*l.w/l.h),h=w*l.h/l.w;
 gfx_rect((GfxRect){x,c.logo+c.logoHeight-h,w,h},l.id,GFX_TEXTO,0,0,0,0,1,1,1,1);glDeleteTextures(1,&l.id);
 label("meta",x,c.meta,.75,.75,.75);label("nota",x,c.secondary,1,.85,.4);
 label("sin1",x,c.synopsis,1,1,1);label("sin2",x,c.synopsis+30,1,1,1);return c.action;
}
