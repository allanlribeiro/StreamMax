static Asset cached[128];static char keys[128][80];static int nCached;
static Asset cachedAsset(const char *s){
  for(int i=0;i<nCached;i++)if(!strcmp(keys[i],s))return cached[i];
  assert(nCached<128);snprintf(keys[nCached],80,"%s",s);cached[nCached]=asset(s);return cached[nCached++];
}
GLuint tex_obter_larg(const char *s,float w){(void)w;if(strstr(s,"aj_tv-minimal-play"))s="tv-icon";if(strstr(s,"/icones/play.png"))s="play-icon";return cachedAsset(s).id;}
float tex_aspecto(const char *s){Asset a=cachedAsset(s);return (float)a.w/a.h;}
