/* REAL_NETFLIX */
/* REAL_CONTINUE */
static unsigned char pixels[1920*1080*4];
static void scene(const char *name,int rows,int normal){
 SmNetflixHome n=sm_netflix_home(1920,1080);focoHero=!rows;netflixAcao=0;
 glClearColor(.035f,.035f,.04f,1);glClear(GL_COLOR_BUFFER_BIT);
 Asset frame=cachedAsset("frame");GfxRect hero={n.margin,n.y,n.w,n.h};
 if(!rows)desenhaHeroNetflix(hero,&item,NULL,"frame",NULL,frame.id,0,0,1,0);
 gfx_cor((GfxRect){0,0,1920,132},0,.035f,.035f,.04f,1);
 gfx_cor((GfxRect){494,35,122,54},.5,.28,.28,.30,1);label("nav",514,48,.98,.98,.98);label("clock",1780,49,.86,.86,.88);
 gfx_cor((GfxRect){88,37,48,48},.2,.7,.1,.18,1);
 float yy=rows?156:n.shelf;
 for(int row=0;row<(rows?2:1);row++){
  int cw=row==0&&!normal;label(cw?"continue":"row2",n.margin,yy,.97,.97,.98);
  float x=n.margin,y=yy+54,w=SM_NETFLIX_POSTER_W,h=SM_NETFLIX_POSTER_H;
  const char *names[]={"poster-10","poster-12","poster-02","poster-00","poster-01","poster-04"};
  for(int i=0;i<6;i++){
   float width=cw&&rows&&i==0?h*16.f/9:w;GfxRect cardRect={x,y,width,h};
   card(cw&&rows&&i==0?"frame":names[i],cardRect);
   if(cw){const char *logos[]={"logo","logo-12","logo-02","logo-00","logo-01","logo-04"};snprintf(item.logo,sizeof item.logo,"%s",logos[i]);item.progresso=45+i*5;continuarNetflix(&item,cardRect,.024f);}
   if(rows&&row==0&&i==0)gfx_anel(cardRect,.024f,2.5,1,1,1,1);
   x+=width+24;
  }
  yy+=54+h+(cw?90:0)+46;
 }
 label("note",88,1048,.58,.58,.62);dump(name,"overlay");
}
int main(int argc,char**argv){
 assert(argc==2);snprintf(assetDir,sizeof assetDir,"%s",argv[1]);
 EGLDisplay d=eglGetDisplay(EGL_DEFAULT_DISPLAY);assert(eglInitialize(d,0,0)&&eglBindAPI(EGL_OPENGL_ES_API));
 EGLint a[]={EGL_SURFACE_TYPE,EGL_PBUFFER_BIT,EGL_RENDERABLE_TYPE,EGL_OPENGL_ES2_BIT,EGL_RED_SIZE,8,EGL_GREEN_SIZE,8,EGL_BLUE_SIZE,8,EGL_ALPHA_SIZE,8,EGL_NONE};EGLConfig cfg;EGLint n;assert(eglChooseConfig(d,a,&cfg,1,&n)&&n);
 EGLint sz[]={EGL_WIDTH,1920,EGL_HEIGHT,1080,EGL_NONE},ca[]={EGL_CONTEXT_CLIENT_VERSION,2,EGL_NONE};EGLSurface surface=eglCreatePbufferSurface(d,cfg,sz);EGLContext context=eglCreateContext(d,cfg,EGL_NO_CONTEXT,ca);assert(eglMakeCurrent(d,surface,surface,context)&&gfx_iniciar());gfx_tamanho_alvo(1920,1080);glViewport(0,0,1920,1080);gfx_icones_dir(assetDir);
 strcpy(item.titulo,"O Astronauta");strcpy(item.tipo,"series");item.temporada=3;item.episodio=1;item.restanteMin=15;strcpy(item.nomeEpisodio,"O recomeço");
 scene("inicio",0,0);scene("continuar",1,0);scene("catalogo",1,1);
 glReadPixels(0,0,1920,1080,GL_RGBA,GL_UNSIGNED_BYTE,pixels);assert(glGetError()==GL_NO_ERROR);
 puts("OK: production Netflix hero and CW functions rendered without GL errors; text/catalog fixtures");
 eglMakeCurrent(d,EGL_NO_SURFACE,EGL_NO_SURFACE,EGL_NO_CONTEXT);eglDestroyContext(d,context);eglDestroySurface(d,surface);eglTerminate(d);
}
