#include <EGL/egl.h>
#include <assert.h>
/* REAL_GFX */
#include "trailerhero.h"

// Preferencias/cores controladas; todo o renderizador e shader sao reais.
int perftv_enabled,perftv_blur,perftv_glass;
float nv_cor_fundo_viva[3]={.04f,.04f,.04f},nv_acento_viva[3],nv_grad_viva[3][3];
float nv_ambiente_viva[4][3],nv_ambiente_forca,nv_tempo_viva;
int nv_grad_ativo;
int ajustes_profundidade(void){return 0;}
float ajustes_profundidade_brilho(void){return 0;}
int ajustes_vidro_fosco(void){return 0;}
int ajustes_vidro(void){return 0;}
int ajustes_vidro_qualidade(void){return 0;}
float nv_layout_w=1920,nv_layout_h=1080;
static int layoutEscolhido,mobile,dono,noCartao,cheia,aberto,quadro,vw=1920,vh=1080,janelaModo;
static GfxRect janela;
static int ultX,ultY,ultW,ultH,ultModo,temUlt;
static float scrollY;
enum { TRAILER_DONO_HOME=1,TRAILER_DONO_DETALHE=2 };
static int layoutHome(void){return layoutEscolhido;}
int ajustes_home_layout(void){return layoutEscolhido;}
int layout_modo_mobile(void){return mobile;}
int video_largura(void){return vw;}
int video_altura(void){return vh;}
int video_quadro_visto(void){return quadro;}
void video_janela(int x,int y,int w,int h){janelaModo=1;janela=(GfxRect){x,y,w,h};}
static void janelaSeMudou(int x,int y,int w,int h,int modo){janelaModo=modo;janela=(GfxRect){x,y,w,h};}
static void janelaKt(int x,int y,int w,int h,int modo){janelaSeMudou(x,y,w,h,modo);}
/* REAL_VIDEO_WINDOW */
static int homeCinematicaTV(void){return layoutEscolhido==HOME_LAYOUT_MODERNA&&!mobile;}
static float homeShelfTop(void){return 378;}
static float homeCabecalhoH(void){return 48;}
/* REAL_HOME */
/* REAL_TRAILER_WINDOW */
enum { W=1280,H=720 };
static unsigned char pixels[W*H*4];
static int alpha(int x,int y){return pixels[((H-1-y)*W+x)*4+3];}
static const unsigned char *pixel(int x,int y){return pixels+((H-1-y)*W+x)*4;}
static void capture(GfxRect box,float progress,float base) {
 glClearColor(.6,.2,.1,1);glClear(GL_COLOR_BUFFER_BIT);
 gfx_furo_hero_suave(box,progress,base);
 glReadPixels(0,0,W,H,GL_RGBA,GL_UNSIGNED_BYTE,pixels);
 assert(glGetError()==GL_NO_ERROR);
}
int main(void) {
 EGLDisplay d=eglGetDisplay(EGL_DEFAULT_DISPLAY);assert(eglInitialize(d,0,0));assert(eglBindAPI(EGL_OPENGL_ES_API));
 EGLint attrs[]={EGL_SURFACE_TYPE,EGL_PBUFFER_BIT,EGL_RENDERABLE_TYPE,EGL_OPENGL_ES2_BIT,EGL_RED_SIZE,8,EGL_GREEN_SIZE,8,EGL_BLUE_SIZE,8,EGL_ALPHA_SIZE,8,EGL_NONE};
 EGLConfig cfg;EGLint n;assert(eglChooseConfig(d,attrs,&cfg,1,&n)&&n);
 EGLint sz[]={EGL_WIDTH,W,EGL_HEIGHT,H,EGL_NONE},ca[]={EGL_CONTEXT_CLIENT_VERSION,2,EGL_NONE};
 EGLSurface surf=eglCreatePbufferSurface(d,cfg,sz);EGLContext ctx=eglCreateContext(d,cfg,EGL_NO_CONTEXT,ca);
 assert(eglMakeCurrent(d,surf,surf,ctx));assert(gfx_iniciar());gfx_tamanho_alvo(W,H);glViewport(0,0,W,H);
#ifdef SM_BAD_BASELINE
 capture((GfxRect){555,0,1421,670},1,0);
 assert(alpha(1100,282)<8);
 puts("REPRODUZIDO 1.0.22: video ainda totalmente visivel na linha dos cartazes; degrade so termina abaixo deles");
#else
 const float scales[]={.85f,.95f,1,1.05f,1.10f,1.25f,1.50f};
 for(unsigned s=0;s<sizeof scales/sizeof scales[0];s++) {
  gfx_escala_txt_definir(scales[s]);float scale=gfx_escala_txt();gfx_escala_sair(scale);
  for(int hero=0;hero<2;hero++) {
   scrollY=hero?-144:0;
   GfxRect box=heroTrailerArea((GfxRect){555,0,1421,670});
   GfxRect plane=heroTrailerVideoRect(box);
   assert(fabsf(plane.x+plane.w-1920)<.01f);
   assert(fabsf(plane.x-box.x*scale)<.01f && fabsf(plane.h-box.h*scale)<.01f);
   float base=fminf(heroTrailerBase(),box.y+box.h);
   int bottom=(int)ceilf(base*scale*H/1080);
   if(bottom>=H)bottom=H-1;
   capture(box,1,base);
   // Direita limpa ate a borda; abaixo da transicao, fundo opaco.
   assert(alpha(W-1,60)<3);
   assert(alpha(1100,bottom)>250);
   int clearY=(int)(base*.60f*scale*H/1080);
   assert(alpha(1100,clearY)<3);
   // Borda esquerda fecha e abre de forma monotona, com valores intermediarios.
   int x0=(int)ceilf(plane.x*W/1920),x1=(int)((plane.x+plane.w*.45f)*W/1920);
   int prev=256,mid=0;
   for(int x=x0;x<=x1;x++) {
    int a=alpha(x,60);assert(a<=prev+1);assert(abs(a-prev)<8 || prev==256);prev=a;
    mid+=a>8&&a<247;
   }
   assert(alpha(x0,60)>250 && mid>100);
   // O fundo fora da caixa e a primeira coluna da rampa devem se encontrar
   // sem uma faixa vertical, inclusive com foto no fundo inteiro.
   for(int c=0;c<3;c++)assert(abs(pixel(x0-1,60)[c]-pixel(x0,60)[c])<=2);
   // Base sem salto de transparencia em pixels vizinhos.
   int start=(int)((base-fminf(144,base*.30f))*scale*H/1080);
   prev=-1;mid=0;
   for(int y=start;y<=bottom;y++) {
    int a=alpha(1100,y);assert(a>=prev-1);assert(a-prev<12);prev=a;
    mid+=a>8&&a<247;
   }
   assert(mid>20);
   capture(box,.5f,base);
   for(int c=0;c<3;c++)assert(abs(pixel(x0-1,60)[c]-pixel(x0,60)[c])<=2);
   assert(abs(alpha(1100,clearY)-128)<3);
   assert(alpha(1100,bottom)>250);
  }
 }
 gfx_escala_sair(1);gfx_escala_txt_definir(1);
 dono=TRAILER_DONO_HOME;layoutEscolhido=HOME_LAYOUT_MODERNA;
 GfxRect box={537.6f,0,1382.4f,670};
 const int sizes[][2]={{0,0},{1920,1080},{1920,804},{1080,1080},{720,1280}};
 for(unsigned i=0;i<sizeof sizes/sizeof sizes[0];i++) {
  vw=sizes[i][0];vh=sizes[i][1];nativoJanela(box,0);
  assert(janelaModo==2 && janela.x<=box.x && janela.x+janela.w>=box.x+box.w);
  janelaModo=0;video_recorte_reaplicar();assert(janelaModo==2);
 }
 noCartao=1;nativoJanela(box,0);assert(janelaModo==1);noCartao=0;
 dono=TRAILER_DONO_DETALHE;nativoJanela(box,0);assert(janelaModo==1);
 dono=TRAILER_DONO_HOME;nativoJanela(box,1);assert(janelaModo==1);
 mobile=1;nativoJanela(box,0);assert(janelaModo==1);
 mobile=0;dono=TRAILER_DONO_HOME;aberto=1;quadro=0;
 assert(!trailer_mostra_video());quadro=1;assert(trailer_mostra_video());
 aberto=0;assert(!trailer_mostra_video());
 puts("OK: gfx.c completo, escalas 85-150%, esquerda/base progressivas, direita preenchida e abertura COVER");
#endif
 eglMakeCurrent(d,EGL_NO_SURFACE,EGL_NO_SURFACE,EGL_NO_CONTEXT);
 eglDestroyContext(d,ctx);eglDestroySurface(d,surf);eglTerminate(d);return 0;
}
