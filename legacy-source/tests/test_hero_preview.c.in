static char assetDir[1024];
typedef struct {GLuint id;uint32_t w,h;} Asset;
static Asset asset(const char *name){
 char path[1400];snprintf(path,sizeof path,"%s/%s.rgba",assetDir,name);
 FILE *f=fopen(path,"rb");assert(f);Asset t={0};
 assert(fread(&t.w,4,1,f)==1&&fread(&t.h,4,1,f)==1);
 assert(t.w&&t.h&&t.w<=4096&&t.h<=4096);
 unsigned char *data=malloc(t.w*t.h*4);assert(data);
 assert(fread(data,4,t.w*t.h,f)==t.w*t.h);fclose(f);
 glGenTextures(1,&t.id);glBindTexture(GL_TEXTURE_2D,t.id);
 glTexImage2D(GL_TEXTURE_2D,0,GL_RGBA,t.w,t.h,0,GL_RGBA,GL_UNSIGNED_BYTE,data);free(data);
 glTexParameteri(GL_TEXTURE_2D,GL_TEXTURE_MIN_FILTER,GL_LINEAR);
 glTexParameteri(GL_TEXTURE_2D,GL_TEXTURE_MAG_FILTER,GL_LINEAR);
 glTexParameteri(GL_TEXTURE_2D,GL_TEXTURE_WRAP_S,GL_CLAMP_TO_EDGE);
 glTexParameteri(GL_TEXTURE_2D,GL_TEXTURE_WRAP_T,GL_CLAMP_TO_EDGE);return t;
}
static void label(const char *name,float x,float y,float r,float g,float b){
 Asset t=asset(name);gfx_rect((GfxRect){x,y,t.w,t.h},t.id,GFX_TEXTO,0,0,0,0,r,g,b,1);glDeleteTextures(1,&t.id);
}
static void card(const char *name,GfxRect r){
 Asset t=asset(name);gfx_tex_aspect_atual=(float)t.w/t.h;
 gfx_rect(r,t.id,GFX_CARD,0,0,0,18/r.h,1,1,1,1);gfx_tex_aspect_atual=0;glDeleteTextures(1,&t.id);
}
static void dump(const char *name,const char *plane){
 char path[1400];snprintf(path,sizeof path,"%s/%s-%s.raw",assetDir,name,plane);
 unsigned char *p=malloc(1920*1080*4);assert(p);
 glReadPixels(0,0,1920,1080,GL_RGBA,GL_UNSIGNED_BYTE,p);assert(glGetError()==GL_NO_ERROR);
 FILE *f=fopen(path,"wb");assert(f);assert(fwrite(p,4,1920*1080,f)==1920*1080);fclose(f);free(p);
}
int main(int argc,char **argv){
 assert(argc==3);snprintf(assetDir,sizeof assetDir,"%s",argv[1]);
 EGLDisplay d=eglGetDisplay(EGL_DEFAULT_DISPLAY);assert(eglInitialize(d,0,0)&&eglBindAPI(EGL_OPENGL_ES_API));
 EGLint a[]={EGL_SURFACE_TYPE,EGL_PBUFFER_BIT,EGL_RENDERABLE_TYPE,EGL_OPENGL_ES2_BIT,EGL_RED_SIZE,8,EGL_GREEN_SIZE,8,EGL_BLUE_SIZE,8,EGL_ALPHA_SIZE,8,EGL_NONE};
 EGLConfig cfg;EGLint n;assert(eglChooseConfig(d,a,&cfg,1,&n)&&n);
 EGLint sz[]={EGL_WIDTH,1920,EGL_HEIGHT,1080,EGL_NONE},ca[]={EGL_CONTEXT_CLIENT_VERSION,2,EGL_NONE};
 EGLSurface s=eglCreatePbufferSurface(d,cfg,sz);EGLContext c=eglCreateContext(d,cfg,EGL_NO_CONTEXT,ca);
 assert(eglMakeCurrent(d,s,s,c)&&gfx_iniciar());gfx_tamanho_alvo(1920,1080);glViewport(0,0,1920,1080);
 GfxRect mask=heroTrailerArea((GfxRect){555,0,1421,670}),plane=heroTrailerVideoRect(mask);
 float base=heroTrailerBase(),x,y,w,h;Asset frame=asset("frame");
 sm_trailer_hero_video(plane.x,plane.y,plane.w,plane.h,frame.w,frame.h,&x,&y,&w,&h);
 glClearColor(.04,.04,.04,1);glClear(GL_COLOR_BUFFER_BIT);
 gfx_rect((GfxRect){lroundf(x),lroundf(y),lroundf(w),lroundf(h)},frame.id,GFX_SNAP,0,0,0,0,1,1,1,1);
 dump(argv[2],"video");glDeleteTextures(1,&frame.id);
 glClearColor(.04,.04,.04,1);glClear(GL_COLOR_BUFFER_BIT);
 gfx_furo_hero_suave(mask,1,base);
 float copyBase=heroBaseCopia(HOME_LAYOUT_MODERNA,mask,0,0);
 HeroCopyLayout copy=heroCopyLayout(copyBase,60,1,1,0,118,54,12,24,0,0);
 Asset logo=asset("logo");float lw=fminf(540,copy.logoHeight*(float)logo.w/logo.h),lh=lw*logo.h/logo.w;
 gfx_rect((GfxRect){104,copy.logo+copy.logoHeight-lh,lw,lh},logo.id,GFX_TEXTO,0,0,0,0,1,1,1,1);glDeleteTextures(1,&logo.id);
 label("meta",104,copy.meta,.7,.7,.7);label("nota",104,copy.secondary,1,.82,.25);
 label("sin1",104,copy.synopsis,1,1,1);label("sin2",104,copy.synopsis+30,1,1,1);
 gfx_cor((GfxRect){1748,30,110,54},.5,.065,.065,.075,.94);label("clock",1769,44,1,1,1);
 float row=homeShelfTop(),cards=row+homeCabecalhoH();
 label("row1",104,row,1,1,1);label("ver",640,row+9,.55,.43,.9);
 const char *posters[]={"poster-00","poster-01","poster-10","poster-02","poster-04","poster-12"};
 float cx=104;
 for(int i=0;i<6;i++){
  if(i==2){
   card("frame",(GfxRect){cx,cards,540,300});
   gfx_veu_base((GfxRect){cx,cards,540,300},18/300.f,.55,.85);
   label("cardmeta",cx+20,cards+263,.8,.8,.8);
   gfx_anel((GfxRect){cx-2,cards-2,544,304},18/304.f,2,.55,.42,.86,1);
   cx+=564;
  }else{card(posters[i],(GfxRect){cx,cards,200,300});cx+=224;}
 }
 row=cards+300+36;label("row2",104,row,.85,.85,.85);
 for(int i=0;i<6;i++)card(posters[(i+3)%6],(GfxRect){104+i*276,row+48,252,378});
 dump(argv[2],"overlay");
 float fadeStart=base-fminf(144,base*.30f);
 printf("{\"cards_y\":%.3f,\"mask_h\":%.3f,\"box_h\":%.3f,\"video_w\":%.3f,\"video_h\":%.3f,\"zoom\":%.5f,\"source_bottom_at_fade\":%.5f}\n",base,mask.h,plane.h,w,h,w/fmaxf(plane.w,plane.h*(16.f/9)),(fadeStart-y)/h);
 eglMakeCurrent(d,EGL_NO_SURFACE,EGL_NO_SURFACE,EGL_NO_CONTEXT);eglDestroyContext(d,c);eglDestroySurface(d,s);eglTerminate(d);return 0;
}
